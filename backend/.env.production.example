APP_NAME=ConTrackPro
APP_ORGANIZATION_NAME="LGU Tuao"
APP_REGION="Municipality of Tuao"
APP_ENV=production
APP_KEY=base64:GENERATE_AND_SET_THIS_IN_HOSTING
APP_DEBUG=false
APP_URL=https://your-backend.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=your-database-name
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password

MAIL_MAILER=log
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
CACHE_STORE=file

# Set to true only for staging/demo environments that should receive QA seed data.
SEED_DEFAULT_DATA=false
